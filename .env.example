# ─── Supabase (FranHRM's own project — never shared with POS/SKUMS) ───
SUPABASE_URL=
SUPABASE_SECRET_KEY=            # sb_secret_... service key (server only)
SUPABASE_PASSWORD=              # DB password (migrations only)
SUPABASE_CONNECTION_STRING=     # postgresql://... pooler string (migrations only)

# ─── MCP stdio identity (remote /mcp derives these from the credential instead) ───
FRAN_HRM_MCP_WORKSPACE_ID=
FRAN_HRM_MCP_PROFILE=safe       # safe | full | unrestricted
FRAN_HRM_MCP_CLIENT=

# ─── MCP OAuth (per-user Claude connector) ───
# Client credentials normally live in the DB (generated in Manage → Connect
# Claude) so rotation is a button. These env vars are a fallback for local dev.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
# Must match the public origin EXACTLY — Claude compares the resource literally.
MCP_OAUTH_ISSUER=
# Extra redirect URIs for local tunnels, comma-separated.
MCP_OAUTH_EXTRA_REDIRECT_URIS=

# ─── Telegram availability bot (docs/TELEGRAM_BOT_SETUP.md) ───
# From @BotFather. Leave empty until J T creates the bot — every send is a
# logged no-op without it; the webhook, linking and in-app notifications
# still work.
TELEGRAM_BOT_TOKEN=
# Random string you pass as secret_token to setWebhook; the webhook rejects
# updates that do not echo it. Generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Optional: chat id of the pilot channel/group for manager digests (numeric,
# negative for groups). Not used by P0 code paths yet.
TELEGRAM_PILOT_CHAT_ID=

# ─── Cron ───
# Vercel sends `Authorization: Bearer $CRON_SECRET` to the reminders job
# (vercel.json crons → /api/v1/scheduling/reminders/run). Any random string.
CRON_SECRET=
